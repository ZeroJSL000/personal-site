---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("project")).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((project) => project.data.featured);
const rest = projects.filter((project) => !project.data.featured);
const categoryOrder = ["Quant research", "Applied AI", "Data systems", "Investment research"] as const;
const groups = categoryOrder
  .map((category) => ({ category, projects: rest.filter((project) => project.data.category === category) }))
  .filter((group) => group.projects.length > 0);
---

<BaseLayout title="Work" description="Selected quantitative research, financial analysis, and applied AI case studies by Shanglin Jiang.">
    <header class="border-b border-line py-16 md:py-24">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(20rem,0.8fr)] lg:items-end">
          <div>
            <p class="eyebrow">Work</p>
            <h1 class="mt-5 max-w-4xl font-display text-5xl leading-[0.96] tracking-[-0.055em] md:text-7xl">
              Systems, experiments, and the evidence between them.
            </h1>
          </div>
          <div class="border-l border-signal/55 pl-6 md:pl-8">
            <p class="text-lg leading-8 text-muted">
              I am most interested in the point where a plausible result meets a harder test: a new
              period, a second evaluator, a shifted domain, or a person who needs to use the system.
            </p>
            <p class="mt-5 text-sm leading-6 text-faint">
              Each case separates what was built, what the evidence supports, and what remains unresolved.
            </p>
          </div>
        </div>
      </Container>
    </header>

    <section class="py-16 md:py-24">
      <Container>
        <div class="flex flex-col gap-4 border-b border-line pb-7 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="eyebrow">Selected cases</p>
            <h2 class="mt-3 font-display text-3xl tracking-[-0.035em] md:text-4xl">Three kinds of evidence</h2>
          </div>
          <p class="max-w-md text-sm leading-6 text-faint">
            Quant engineering, traceable investment research, and an independently built AI product.
          </p>
        </div>
        <div class="mt-8 grid gap-4 lg:grid-cols-3">
          {
            featured.map((project) => (
              <ProjectCard
                href={`/projects/${project.id}`}
                title={project.data.title}
                question={project.data.question}
                category={project.data.category}
                context={project.data.context}
                dates={project.data.dates}
                tags={project.data.tags}
                metric={project.data.metrics[0]}
                large
              />
            ))
          }
        </div>
      </Container>
    </section>

    <section class="border-t border-line py-16 md:py-24">
      <Container>
        <a
          href="/projects/exit-curve"
          class="group mb-16 grid gap-7 border border-signal/40 bg-panel/35 p-7 transition-colors hover:border-signal focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-signal md:grid-cols-[minmax(0,1fr)_auto] md:items-end md:p-9"
        >
          <div>
            <p class="eyebrow">Independent system · crypto markets</p>
            <h2 class="mt-4 font-display text-3xl leading-[1.12] tracking-[-0.035em] md:text-4xl">
              A research idea, tested and taken into live trading.
            </h2>
            <p class="mt-4 max-w-3xl text-base leading-7 text-muted">
              Time-dependent profit targets, a Freqtrade deployment in a dedicated server environment I built,
              Binance API connectivity, and a profitable observed real-capital period. The case
              shows the simulator's mixed cross-asset evidence and the limits of the live record.
            </p>
          </div>
          <span class="text-sm text-signal transition-transform group-hover:translate-x-1">Read the case ↗</span>
        </a>

        <div class="max-w-2xl">
          <p class="eyebrow">Research notes &amp; supporting work</p>
          <h2 class="mt-3 font-display text-3xl tracking-[-0.035em] md:text-4xl">The rest of the evidence</h2>
          <p class="mt-5 text-base leading-7 text-muted">
            These projects add depth in experimental design, dataset quality, distributed systems,
            domain shift, and risk. They are intentionally presented with narrower claims.
          </p>
        </div>

        <div class="mt-14 space-y-16">
          {
            groups.map((group) => (
              <section aria-labelledby={`group-${group.category.replaceAll(" ", "-")}`}>
                <div class="grid gap-4 md:grid-cols-[12rem_minmax(0,1fr)]">
                  <div>
                    <h3
                      id={`group-${group.category.replaceAll(" ", "-")}`}
                      class="font-mono text-[0.72rem] uppercase tracking-[0.16em] text-signal"
                    >
                      {group.category}
                    </h3>
                    <p class="mt-2 text-sm text-faint">{String(group.projects.length).padStart(2, "0")} cases</p>
                  </div>
                  <div class="grid gap-4 lg:grid-cols-2">
                    {group.projects.map((project) => (
                      <ProjectCard
                        href={`/projects/${project.id}`}
                        title={project.data.title}
                        question={project.data.question}
                        category={project.data.category}
                        context={project.data.context}
                        dates={project.data.dates}
                        tags={project.data.tags}
                        metric={project.data.metrics[0]}
                        headingLevel={4}
                      />
                    ))}
                  </div>
                </div>
              </section>
            ))
          }
        </div>
      </Container>
    </section>
</BaseLayout>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-signal);
  }
</style>
