---
interface Chapter {
  id: string;
  kicker: string;
  title: string;
  body: string;
  visual: "noise" | "network" | "metrics" | "still";
}

interface Props {
  chapters: Chapter[];
}

const { chapters } = Astro.props;
---

<section data-scrolly class="relative mx-auto grid max-w-6xl gap-10 px-5 py-16 md:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] md:px-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)]">
  <div class="space-y-28 md:space-y-40">
    {
      chapters.map((chapter) => (
        <article
          data-step={chapter.id}
          class:list={[
            "max-w-xl border-l border-line pl-6 transition-colors",
            chapter.id === chapters[0]?.id && "is-active",
          ]}
        >
          <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-signal">{chapter.kicker}</p>
          <h2 class="mt-3 font-display text-3xl tracking-tight">{chapter.title}</h2>
          <p class="mt-4 text-sm leading-7 text-muted">{chapter.body}</p>
        </article>
      ))
    }
  </div>
  <div class="hidden md:block">
    <div class="sticky top-24 h-[28rem] overflow-hidden border border-line bg-panel">
      {
        chapters.map((chapter) => (
          <div
            data-visual={chapter.id}
            class:list={[
              "absolute inset-0 transition-opacity duration-500",
              chapter.id === chapters[0]?.id && "is-active",
            ]}
          >
            {chapter.visual === "noise" && <div class="noise-panel h-full" />}
            {chapter.visual === "network" && <div class="network-panel h-full" />}
            {chapter.visual === "metrics" && (
              <div class="flex h-full flex-col justify-end gap-6 p-8 font-mono">
                <p class="text-[10px] uppercase tracking-[0.2em] text-faint">Evidence</p>
                <p class="text-4xl tabular text-ink">1.011</p>
                <p class="text-sm text-muted">
                  Held-out eval loss on a fixed 500-item set (from 1.612 base).
                </p>
                <p class="text-[11px] text-signal">Public demo link waits until the domain is stable.</p>
              </div>
            )}
            {chapter.visual === "still" && (
              <div class="flex h-full items-end p-8">
                <p class="max-w-[16rem] text-sm leading-6 text-muted">
                  The deployed MVP and the larger Spark and Ray design stay separate. This page does
                  not depend on a live demo server.
                </p>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .noise-panel {
    background-image: radial-gradient(circle, rgba(126, 184, 196, 0.45) 0.8px, transparent 1.1px);
    background-size: 14px 18px;
    opacity: 0.55;
  }
  .network-panel {
    background:
      linear-gradient(115deg, transparent 40%, rgba(126, 184, 196, 0.18) 41%, transparent 42%),
      linear-gradient(205deg, transparent 48%, rgba(126, 184, 196, 0.12) 49%, transparent 50%),
      radial-gradient(circle at 30% 40%, rgba(126, 184, 196, 0.55) 2px, transparent 2.4px),
      radial-gradient(circle at 62% 28%, rgba(231, 238, 243, 0.5) 2px, transparent 2.4px),
      radial-gradient(circle at 70% 66%, rgba(126, 184, 196, 0.45) 2px, transparent 2.4px);
  }
  [data-step].is-active {
    border-color: var(--color-signal);
  }
  [data-visual] {
    opacity: 0;
  }
  [data-visual].is-active {
    opacity: 1;
  }
</style>

<script>
  import { initFlagshipScrolly } from "../lib/flagship-scrolly";
  initFlagshipScrolly();
</script>
