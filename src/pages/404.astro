---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
---

<BaseLayout title="Not found">
  <section class="py-24">
    <Container narrow>
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-faint">404</p>
      <h1 class="mt-3 font-display text-4xl tracking-tight">This path has no signal.</h1>
      <p class="mt-4 text-sm text-muted">
        <a class="text-signal underline" href="/">Return home</a>
      </p>
    </Container>
  </section>
</BaseLayout>
