---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeaturedCard from "../components/FeaturedCard.astro";
import Container from "../components/Container.astro";
import HomeStage from "../motion/v1.1/HomeStage.astro";
import { getFeaturedCards } from "../lib/featured";

const featuredCards = await getFeaturedCards();
---

<BaseLayout>
  <HomeStage />

  <section id="selected-work" data-featured class="scroll-mt-28 border-t border-line py-16 md:py-24">
    <Container>
      <div class="grid gap-8 border-b border-line pb-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(20rem,0.85fr)] lg:items-end">
        <div>
          <p class="eyebrow">Three selected cases</p>
          <h2 class="mt-4 max-w-3xl font-display text-4xl leading-[1.02] tracking-[-0.045em] md:text-6xl">
            Three questions that led to deeper investigation.
          </h2>
        </div>
        <p class="max-w-xl text-base leading-8 text-muted lg:justify-self-end">
          One began with a GPU constraint, one with unreliable fund records, and one with a small
          language model. Each became a lesson in what counts as evidence.
        </p>
      </div>

      <div>
        {featuredCards.map((card) => <FeaturedCard {...card} />)}
      </div>
    </Container>
  </section>

  <section class="border-t border-line bg-panel/25 py-16 md:py-20">
    <Container>
      <div class="max-w-3xl">
        <p class="eyebrow">Continue</p>
        <h2 class="mt-3 font-display text-3xl leading-tight tracking-[-0.035em] md:text-4xl">
          Go deeper by evidence, context, or trajectory.
        </h2>
      </div>
      <div class="explore-grid">
        <a href="/projects">
          <span>01 / Work</span>
          <h3>All case studies</h3>
          <p>Full cases, research studies, and concise technical briefs.</p>
          <i aria-hidden="true">↗</i>
        </a>
        <a href="/experience">
          <span>02 / Experience</span>
          <h3>Roles in context</h3>
          <p>Industry research, faculty-supervised work, and early risk experience.</p>
          <i aria-hidden="true">↗</i>
        </a>
        <a href="/about">
          <span>03 / Profile</span>
          <h3>Education and direction</h3>
          <p>The path connecting quantitative research, evidence systems, and applied AI.</p>
          <i aria-hidden="true">↗</i>
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-signal);
  }

  .explore-grid {
    display: grid;
    margin-top: 2.5rem;
    border-top: 1px solid var(--color-line);
  }

  .explore-grid a {
    display: grid;
    gap: 1rem;
    min-height: 15rem;
    border-bottom: 1px solid var(--color-line);
    padding-block: 1.75rem;
    transition: color 180ms ease, background-color 180ms ease;
  }

  .explore-grid a:hover,
  .explore-grid a:focus-visible {
    background: color-mix(in srgb, var(--color-signal) 4%, transparent);
  }

  .explore-grid span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-signal);
  }

  .explore-grid h3 {
    align-self: end;
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .explore-grid p {
    max-width: 22rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .explore-grid i {
    justify-self: end;
    font-style: normal;
    color: var(--color-faint);
  }

  [data-featured-card].is-in {
    opacity: 1;
    transform: none;
  }

  @media (min-width: 700px) {
    .explore-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .explore-grid a {
      border-bottom: 0;
      border-left: 1px solid var(--color-line);
      padding: 1.75rem;
    }

    .explore-grid a:first-child {
      border-left: 0;
      padding-left: 0;
    }

    .explore-grid a:last-child {
      padding-right: 0;
    }
  }
</style>
