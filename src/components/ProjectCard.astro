---
interface Props {
  href: string;
  title: string;
  question: string;
  category: string;
  context: string;
  dates: string;
  tags: string[];
  metric?: { value: string; label: string };
  large?: boolean;
  headingLevel?: 3 | 4;
}

const { href, title, question, category, context, dates, tags, metric, large = false, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 4 ? "h4" : "h3";
---

<a
  href={href}
  class:list={[
    "project-card group relative flex h-full flex-col border border-line bg-panel/30 p-6 transition-colors hover:border-signal/60 focus-visible:outline-none md:p-7",
    large && "md:min-h-[25rem] md:p-9",
  ]}
>
  <div class="flex items-start justify-between gap-5">
    <p class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-signal">{category}</p>
    <span aria-hidden="true" class="text-sm text-faint transition-transform duration-300 group-hover:translate-x-1">↗</span>
  </div>
  <Heading class:list={["mt-8 font-display leading-[1.08] tracking-[-0.03em] text-ink", large ? "text-3xl" : "text-2xl"]}>
    {title}
  </Heading>
  <p class="mt-4 text-base leading-7 text-muted">{question}</p>

  {
    metric && (
      <div class="mt-8 border-l border-signal/50 pl-4">
        <p class="font-display text-2xl tracking-[-0.03em] text-ink">{metric.value}</p>
        <p class="mt-1 text-sm leading-5 text-muted">{metric.label}</p>
      </div>
    )
  }

  <div class="mt-auto pt-10">
    <p class="text-sm leading-6 text-faint">{context} · {dates}</p>
    <p class="mt-4 flex flex-wrap gap-x-4 gap-y-2 font-mono text-[0.68rem] uppercase tracking-[0.11em] text-faint">
      {tags.map((tag) => <span>{tag}</span>)}
    </p>
  </div>
</a>

<style>
  .project-card:focus-visible {
    box-shadow: 0 0 0 2px var(--color-canvas), 0 0 0 4px var(--color-signal);
  }

  .project-card::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(135deg, color-mix(in srgb, var(--color-signal) 8%, transparent), transparent 45%);
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .project-card:hover::after,
  .project-card:focus-visible::after {
    opacity: 1;
  }
</style>
