---
interface Props {
  href: string;
  kicker: string;
  title: string;
  summary: string;
  question: string;
  meta: string;
  status: string;
  tags: string[];
  metrics: Array<{ value: string; label: string }>;
}

const { href, kicker, title, summary, question, meta, status, tags, metrics } = Astro.props;
---

<a
  href={href}
  data-featured-card
  class="featured-case group grid gap-8 border-t border-line py-10 focus-visible:outline-none md:grid-cols-[9rem_minmax(0,1fr)_15rem] md:gap-10 md:py-14"
>
  <div>
    <p class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-signal">{kicker}</p>
    <p class="mt-3 text-sm leading-6 text-faint">{status}</p>
  </div>

  <div>
    <p class="text-sm leading-6 text-signal/90">{question}</p>
    <h3 class="mt-3 max-w-2xl font-display text-3xl leading-[1.04] tracking-[-0.035em] text-ink md:text-4xl">
      {title}
    </h3>
    <p class="mt-5 max-w-2xl text-base leading-7 text-muted">{summary}</p>
    <p class="mt-6 font-mono text-[0.72rem] leading-5 text-faint">{meta}</p>
    <p class="mt-4 flex flex-wrap gap-x-4 gap-y-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-faint">
      {tags.map((tag) => <span>{tag}</span>)}
    </p>
  </div>

  <div class="flex flex-col justify-between gap-8 md:border-l md:border-line md:pl-8">
    <dl class="grid grid-cols-2 gap-5 md:grid-cols-1">
      {
        metrics.map((metric) => (
          <div>
            <dt class="font-display text-2xl tracking-[-0.03em] text-ink">{metric.value}</dt>
            <dd class="mt-1 text-sm leading-5 text-muted">{metric.label}</dd>
          </div>
        ))
      }
    </dl>
    <span class="inline-flex items-center gap-3 text-sm text-ink">
      Read the case
      <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">↗</span>
    </span>
  </div>
</a>

<style>
  .featured-case {
    position: relative;
  }

  .featured-case::before {
    content: "";
    position: absolute;
    inset: -1px 0 auto;
    height: 1px;
    background: var(--color-signal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 450ms var(--ease-out);
  }

  .featured-case:hover::before,
  .featured-case:focus-visible::before {
    transform: scaleX(1);
  }

  .featured-case:focus-visible {
    box-shadow: 0 0 0 2px var(--color-canvas), 0 0 0 4px var(--color-signal);
  }
</style>
